# Athena frontend - local development env.
# Copy to `.env.local` for `pnpm dev`. (Next picks up `.env.local` automatically.)
# Docker compose passes these directly.

# Public - bundled into the browser. Never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Athena

# Supabase - auth backend. Create a free project at
# https://supabase.com/dashboard, then under Authentication → Providers:
#   - enable GitHub OAuth and Google OAuth (paste each provider's client
#     id/secret; add https://<project>.supabase.co/auth/v1/callback as the
#     provider's redirect URI),
#   - enable the Email provider (passwords stay off - Athena uses OTP only),
#   - edit Email Templates → "Magic Link" to include BOTH {{ .Token }} (the
#     6-digit code) and {{ .ConfirmationURL }} (the link),
#   - disable automatic identity linking so one email = one auth method,
#   - add your app origins + /auth/callback to URL Configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile - CAPTCHA on the email-OTP send. Public site key only
# (the secret goes in Supabase → Authentication → Attack Protection → CAPTCHA,
# provider = Turnstile). Leave empty to skip the CAPTCHA widget (local/dev).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
