# Athena frontend — local development env.
# Copy to `.env.local` for `pnpm dev`. (Next picks up `.env.local` automatically.)
# Docker compose passes these directly.

# Public — bundled into the browser. Never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Athena

# Feature flag — show "Start demo run" / "Generate a PRD" on the dashboard.
# Defaults to true in dev. Production manifests set false once real runs ship
# and we don't want the scripted SSE demo cluttering the UI.
NEXT_PUBLIC_ENABLE_DEMO=true
