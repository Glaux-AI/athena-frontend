{
  "name": "athena-web",
  "version": "0.1.0",
  "private": true,
  "description": "Athena enterprise PDLC engine — web app (Next.js 15)",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev --turbo --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint && eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,css,json}\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "lighthouse": "lhci autorun --config=.lighthouserc.json",
    "lighthouse:local": "lhci autorun --config=.lighthouserc.json --collect.startServerCommand='pnpm start' --collect.startServerReadyPattern='Ready'"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "cytoscape": "^3.30.0",
    "cytoscape-dagre": "^2.5.0",
    "cytoscape-fcose": "^2.2.0",
    "lucide-react": "^0.451.0",
    "mermaid": "^11.15.0",
    "next": "15.5.18",
    "next-themes": "^0.3.0",
    "react": "19.0.0-rc-66855b96-20241106",
    "react-dom": "19.0.0-rc-66855b96-20241106",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4.0.0-beta.4",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitest/ui": "^3.2.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.12.0",
    "eslint-config-next": "15.5.18",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.0.0-beta.4",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  },
  "resolutions": {
    "cookie": ">=0.7.0",
    "tmp": ">=0.2.6",
    "uuid@<11.1.1": ">=11.1.1",
    "postcss@<8.5.10": ">=8.5.10",
    "vite@<6.4.2": ">=6.4.2",
    "esbuild@<0.25.0": ">=0.25.0"
  }
}
